import numpy as np

# Function: f(x) = x^4 - 4x + 4
def f(x):
    return x**4 - 4*x + 4

# First derivative: f'(x) = 4x^3 - 4
def df(x):
    return 4*x**3 - 4

# Second derivative: f''(x) = 12x^2
def d2f(x):
    return 12*x**2

# Initial guess (avoid x = 0 because d2f(0) = 0 causes division by zero)
x = 2.0

# Tolerance
tol = 1e-6
# Maximum iterations
max_iter = 20

print("Iteration\tx")

for i in range(max_iter):
    x_new = x - df(x) / d2f(x)
    print(f"{i+1}\t\t{round(x_new, 6)}")
    
    if abs(x_new - x) < tol:
        break
    x = x_new

print("\nOptimal Point =", round(x_new, 6))
print("Minimum Function Value =", round(f(x_new), 6))
